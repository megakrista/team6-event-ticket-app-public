// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique //rn it won't be possible to re-use email after soft delete
  passwordHash  String?
  firstName     String
  lastName      String
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdEvents Event[]
  sessions      Session[]
  tickets       Ticket[]
  accounts      OAuthAccount[]
  orders        Order[]
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Venue {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String
  latitude  Decimal
  longitude Decimal
  timezone  String
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  description String      @db.Text
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  price       Decimal
  imageUrl    String?
  category    String
  status      EventStatus
  version     Int         @default(0)
  venueId     String      @db.Uuid
  venue       Venue       @relation(fields: [venueId], references: [id])
  createdById String      @db.Uuid
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tickets     Ticket[]
  orders      Order[]

  @@index([status, startsAt])
  @@index([status, category, startsAt])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TicketStatus {
  PENDING
  PAID
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  idempotencyKey   String      @unique
  totalAmount      Decimal     @db.Decimal(12, 2)
  currency         String      @default("eur")
  quantity         Int
  status           OrderStatus @default(PENDING)
  eventId          String      @db.Uuid
  event            Event       @relation(fields: [eventId], references: [id])
  userId           String?     @db.Uuid
  user             User?       @relation(fields: [userId], references: [id])
  buyerName        String
  buyerEmail       String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  payments         Payment[]
  tickets          Ticket[]

  @@index([eventId, status])
  @@index([userId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  method            String        @default("stripe")
  externalPaymentId String        @unique
  orderId           String        @db.Uuid
  order             Order         @relation(fields: [orderId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  ticketNumber  String       @unique
  attendeeName  String
  attendeeEmail String
  pricePaid     Decimal      @db.Decimal(12, 2)
  status        TicketStatus @default(PENDING)
  orderId       String       @db.Uuid
  order         Order        @relation(fields: [orderId], references: [id])
  eventId       String       @db.Uuid
  event         Event        @relation(fields: [eventId], references: [id])
  userId        String?      @db.Uuid
  user          User?        @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([eventId, status])
  @@index([orderId])
}
